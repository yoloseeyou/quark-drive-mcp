# 复制为 .env 后填写。.env 已被 .gitignore 忽略，请勿提交真实凭证。
# 加载顺序：真实环境变量 > .env（dotenv 不覆盖已存在的变量），
# 因此 MCP 客户端 env 中注入的值优先级最高。

# ══ 只需要填写下面三项：链接、密钥、密码 ═══════════════════════════

# 1) 链接：aria2 RPC 地址
ARIA2_RPC_URL=http://127.0.0.1:6800/jsonrpc

# 2) 密钥：aria2 rpc-secret 的原始值（不要带 token: 前缀）；RPC 未设密码则留空
ARIA2_RPC_SECRET=

# 3) 密码：夸克网盘登录 Cookie（浏览器开发者工具 Network 面板复制完整值）
QUARK_COOKIE=

# ══ 以下均可不填，留空即使用默认值 ═══════════════════════════════

# ── HTTP 模式（--transport=http）──────────────────────────────────
# 访问令牌：配置后所有请求必须带 Authorization: Bearer <令牌>，否则 401。
# 留空时仅允许监听回环地址（127.0.0.1 / ::1 / localhost），监听其它地址会拒绝启动。
# 它由你自己生成（不是向平台申请），例如：openssl rand -hex 32
# 改掉它即可让所有旧客户端立即失效。
MCP_HTTP_TOKEN=

# 设为 1 才允许「非回环地址 + 无令牌」监听。仅在你已用反向代理 / 内网隔离
# 保护该端口时才开启，否则任何能访问端口的人都获得了你的网盘权限。
MCP_HTTP_ALLOW_INSECURE=

# 默认下载目录；留空则使用 aria2 自身配置的 dir
ARIA2_DOWNLOAD_DIR=

# 日志级别：debug | info | warn | error | silent
MCP_LOG_LEVEL=info

# 目录缓存有效期（毫秒），默认 3600000（1 小时）
DRIVE_CACHE_TTL_MS=3600000

# 目录缓存条目上限，超限按 LRU 淘汰，默认 500；设为 0 即关闭缓存
DRIVE_CACHE_MAX_ENTRIES=500

# 写操作确认令牌有效期（毫秒），默认 300000（5 分钟）
CONFIRM_TTL_MS=300000

# Tavily 搜索 API 密钥（启用 tavily_search / tavily_extract_links 时必填）
TAVILY_API_KEY=

# Tavily API 地址，一般无需修改
# TAVILY_BASE_URL=https://api.tavily.com

# ── 高级：以下很少需要改动 ────────────────────────────────────────
# QUARK_BASE_URL=https://drive.quark.cn
# ⚠️ 必须是「夸克 PC 客户端」UA：普通浏览器 UA 取直链会被拒（code=23018）
# QUARK_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) quark-cloud-drive/2.5.20 Chrome/100.0.4896.160 Electron/18.3.5.4 Safari/537.36 Channel/395ed7d3
# QUARK_REFERER=https://pan.quark.cn/
# QUARK_ORIGIN=https://pan.quark.cn
# QUARK_PR=ucpro
# QUARK_FR=pc
# UC_PARAM_STR=dn
