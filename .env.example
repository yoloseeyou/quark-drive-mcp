# 复制为 .env 后填写。.env 已被 .gitignore 忽略，请勿提交真实凭证。
# 加载顺序：真实环境变量 > .env（dotenv 不覆盖已存在的变量），
# 因此 MCP 客户端 env 中注入的值优先级最高。

# ══ 只需要填写下面三项：链接、密钥、密码 ═══════════════════════════

# 1) 链接：aria2 RPC 地址
ARIA2_RPC_URL=http://127.0.0.1:6800/jsonrpc

# 2) 密钥：aria2 rpc-secret 的原始值（不要带 token: 前缀）；RPC 未设密码则留空
ARIA2_RPC_SECRET=

# 3) 密码：夸克网盘登录 Cookie（浏览器开发者工具 Network 面板复制完整值）
QUARK_COOKIE=

# ══ 以下均可不填，留空即使用默认值 ═══════════════════════════════

# 默认下载目录；留空则使用 aria2 自身配置的 dir
ARIA2_DOWNLOAD_DIR=

# 日志级别：debug | info | warn | error | silent
MCP_LOG_LEVEL=info

# 目录缓存有效期（毫秒），默认 3600000（1 小时）
DRIVE_CACHE_TTL_MS=3600000

# 目录缓存条目上限，超限按 LRU 淘汰，默认 500
DRIVE_CACHE_MAX_ENTRIES=500

# ── 高级：以下很少需要改动 ────────────────────────────────────────
# QUARK_BASE_URL=https://drive.quark.cn
# QUARK_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
# QUARK_REFERER=https://pan.quark.cn/
# QUARK_ORIGIN=https://pan.quark.cn
# QUARK_PR=ucpro
# QUARK_FR=pc
# UC_PARAM_STR=dn
